# Supabase (get from https://supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only — NEVER prefix with VITE_
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=sk-YOUR_KEY
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
GEMINI_API_KEY=AIzaSy-YOUR_KEY

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
# Price IDs — create in Stripe Dashboard → Products
STRIPE_PRICE_STARTER_MONTHLY=price_YOUR_ID
STRIPE_PRICE_STARTER_ANNUAL=price_YOUR_ID
STRIPE_PRICE_PRO_MONTHLY=price_YOUR_ID
STRIPE_PRICE_PRO_ANNUAL=price_YOUR_ID
STRIPE_PRICE_BIZ_MONTHLY=price_YOUR_ID
STRIPE_PRICE_BIZ_ANNUAL=price_YOUR_ID

# Public (safe in frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY
VITE_APP_URL=http://localhost:5173
