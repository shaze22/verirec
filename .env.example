# Supabase (get from https://supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only — NEVER prefix with VITE_
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=sk-YOUR_KEY
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
BILLPLZ_API_KEY=YOUR_KEY
BILLPLZ_COLLECTION_ID=YOUR_ID
BILLPLZ_X_SIGNATURE=YOUR_SIGNATURE
BILLPLZ_SANDBOX=true

# Public (safe in frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY
VITE_APP_URL=http://localhost:5173
